# Copy this file to .env.local and fill in the values. Never commit .env.local.

# Storage backend: memory | aws
STORAGE=memory

# LLM provider: gemini | bedrock
LLM_PROVIDER=gemini
# Optional second provider, used when the first one is throttled, out of quota or denied: gemini | (empty)
LLM_FALLBACK=

# Rate limits per IP per minute (in memory, per server instance)
RATE_LIMIT_PER_MIN=30
LLM_RATE_LIMIT_PER_MIN=10

# Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# AWS
AWS_REGION=eu-west-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
BEDROCK_MODEL_ID=eu.amazon.nova-2-lite-v1:0
DYNAMODB_TABLE=duly
S3_BUCKET=duly-devcaos-files
