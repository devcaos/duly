# Copy this file to .env.local and fill in the values. Never commit .env.local.

# Storage backend: memory | aws
STORAGE=memory

# LLM provider: gemini | bedrock
LLM_PROVIDER=gemini
# Optional second provider, used when the first one is throttled, unavailable or times out (never on access errors): gemini | (empty)
LLM_FALLBACK=

# Rate limits per IP per minute (in memory, per server instance)
RATE_LIMIT_PER_MIN=30
LLM_RATE_LIMIT_PER_MIN=10

# Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# AWS
AWS_REGION=eu-west-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
BEDROCK_MODEL_ID=eu.amazon.nova-2-lite-v1:0
DYNAMODB_TABLE=duly
S3_BUCKET=duly-devcaos-files
# Amazon Polly neural voice for the demo web (en-US)
POLLY_VOICE_ID=Joanna

# Demo web: MCP server the /api/chat agent connects to. Empty = this app's own /api/mcp. A
# different host is called without DULY_INTERNAL_TOKEN.
MCP_URL=
# Demo web: shared secret (at least 16 random characters) that /api/chat sends to /api/mcp so its
# internal calls skip the per-IP limit there (/api/chat limits each visitor itself). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
DULY_INTERNAL_TOKEN=
# /api/mcp only answers requests whose Host is localhost, 127.0.0.1, [::1] or this deployment's own
# Vercel host (403 otherwise, to block DNS rebinding). Comma-separated extra hosts, e.g. a custom
# domain or a LAN IP: duly-home.vercel.app,192.168.1.20. They never receive DULY_INTERNAL_TOKEN.
MCP_ALLOWED_HOSTS=

# Local testing without AWS (npm run mock:aws). Leave empty to use real AWS.
AWS_ENDPOINT_URL_BEDROCK_RUNTIME=
AWS_ENDPOINT_URL_POLLY=
