# Copy this file to .env.local and fill in the values. Never commit .env.local.

# Storage backend: memory | aws
STORAGE=memory

# LLM provider: bedrock | gemini
LLM_PROVIDER=bedrock

# AWS
AWS_REGION=eu-west-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
BEDROCK_MODEL_ID=eu.amazon.nova-2-lite-v1:0
DYNAMODB_TABLE=papertrail
S3_BUCKET=

# Gemini (fallback)
GEMINI_API_KEY=
